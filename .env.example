# Nusxa oling:  lokal ishlash uchun  -> .env.local   (npm run dev)
#               serverda Docker bilan -> .env         (docker compose up -d --build)
# Hamma qiymat server tomonda, ishga tushganda o'qiladi (qayta build kerak emas).

# Next.js server backend'ga qayerdan murojaat qiladi.
#   lokal:  http://127.0.0.1:8010        (backend docker compose'da 8010-portda)
#   server: http://backend:8000          (bir Docker tarmog'ida)
API_URL=http://127.0.0.1:8010

# Shu saytning o'z manzili. Backend .env dagi CORS_ORIGINS ichida AYNAN shu bo'lishi shart.
#   lokal:  http://localhost:3000        server: https://javon.uz
APP_URL=http://localhost:3000

# Do'kon subdomenlari: <slug>.BASE_DOMAIN
#   lokal:  localhost (varaq.localhost:3000 brauzerda ishlaydi)    server: javon.uz
BASE_DOMAIN=localhost

# Do'kon saytining manzili admin panelda va QR'da ko'rinadi ({slug} almashtiriladi).
#   lokal:  http://localhost:3000/s/{slug}     server: https://{slug}.javon.uz
STORE_URL_TEMPLATE=http://localhost:3000/s/{slug}

# Platforma boti (Telegram Login Widget), @ belgisiz. Backend'dagi PLATFORM_BOT_USERNAME bilan bir xil.
# @BotFather'da /setdomain qilingan domen bo'lishi shart (lokal http://localhost'da widget ishlamaydi).
TELEGRAM_BOT_USERNAME=

# Lokal kirish formasi (Telegram'siz). Faqat backend ENV=local va DEBUG=true bo'lganda ishlaydi.
# Serverda false qoldiring.
DEV_LOGIN=true

# Yordam xizmati Telegram akkaunti, @ belgisiz (bosh sahifa pastida).
SUPPORT_TELEGRAM=
